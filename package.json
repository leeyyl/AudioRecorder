    "expo": "^52.0.32",
    "expo-auth-session": "~6.0.3",
    "expo-av": "~15.0.2",
    "expo-blur": "~14.0.3",
    "expo-constants": "~17.0.7",
    "expo-crypto": "~14.0.2",
    "expo-linear-gradient": "^14.0.2",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.17",
